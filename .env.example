# Copiar para .env.local (local) ou para as variáveis de ambiente da Vercel.
# Gerar valores: npm run secrets   |   palavra-passe do admin: npm run hash-password -- "a-tua-palavra-passe"

# Endereço público do site (usado nos links dos convites e na pré-visualização do WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (deixar vazio em desenvolvimento => usa a base local em .data/db.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave AES-256 (base64, 32 bytes) para cifrar os tokens dos convites
TOKEN_ENC_KEY=

# Segredo para assinar a sessão do admin (base64, 32+ bytes)
SESSION_SECRET=

# Hash scrypt da palavra-passe do admin (formato scrypt:salt:hash)
ADMIN_PASSWORD_HASH=
